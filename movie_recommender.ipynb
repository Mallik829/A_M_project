    "def top_movies(n=10):\n",
    "\n",
    "    movie_stats = (\n",
    "        df.groupby(\"title\")[\"rating\"]\n",
    "        .agg(\n",
    "            avg_rating=\"mean\",\n",
    "            number_of_ratings=\"count\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "    movie_stats = movie_stats[\n",
    "        movie_stats[\"number_of_ratings\"] >= 50\n",
    "    ]\n",
    "\n",
    "    return (\n",
    "        movie_stats\n",
    "        .sort_values(\n",
    "            \"avg_rating\",\n",
    "            ascending=False\n",
    "        )\n",
    "        .head(n)\n",
    "    )"
   ]
