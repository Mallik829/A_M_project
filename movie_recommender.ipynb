    "df = movie_data\n",
    "\n",
    "user_movie_matrix = df.pivot_table(\n",
    "    index=\"user_id\",\n",
    "    columns=\"title\",\n",
    "    values=\"rating\"\n",
    ")\n",
    "\n",
    "user_movie_matrix.shape"
   ]
